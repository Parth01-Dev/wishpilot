{% comment %}
  WishPilot — App embed (required on collection pages for pasteable card buttons).
  Theme editor → App embeds → enable WishPilot.
{% endcomment %}

{{ 'wishpilot.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wishpilot-add.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "WishPilot",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Required for wishlist hearts on collection cards. Enable this embed, then paste the Liquid snippet from WishPilot → Settings into your product card (e.g. card-product.liquid)."
    }
  ]
}
{% endschema %}
