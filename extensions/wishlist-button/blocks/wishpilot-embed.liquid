{% comment %}
  WishPilot — App embed (recommended on every theme).
  Also loads storefront JS/CSS from the app host so wishlist works on collections.
{% endcomment %}

<link rel="stylesheet" href="https://victorious-wishpilot-production.up.railway.app/wishpilot/add.css" media="all">
<script src="https://victorious-wishpilot-production.up.railway.app/wishpilot/add.js" defer></script>

{% schema %}
{
  "name": "WishPilot",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Loads wishlist hearts CSS/JS on every page. Enable this embed, and for collection cards also paste the snippet from WishPilot → Settings."
    }
  ]
}
{% endschema %}
